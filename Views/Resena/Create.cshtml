@model Scentify.Models.Resena

@{
    ViewData["Title"] = "Crear Reseña";
}

<style>
    /* ── ESTILOS LUXURY PANEL ADMIN - CREAR ── */
    .lux-form-container {
        font-family: 'Montserrat', sans-serif;
        color: var(--scent-white, #F8F4EE);
        max-width: 600px;
        margin: 3rem auto;
        background: rgba(10, 10, 10, 0.95);
        border: 1px solid var(--glass-border, rgba(201, 168, 76, 0.22));
        border-radius: 4px;
        padding: 2.5rem 2rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .lux-form-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.2rem;
        color: var(--gold, #C9A84C);
        letter-spacing: 0.1em;
        font-weight: 300;
        text-align: center;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(201, 168, 76, 0.2);
        padding-bottom: 1rem;
    }

    .lux-label {
        color: var(--gold-light, #E8D5A3);
        font-size: 0.70rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        margin-bottom: 0.8rem;
        display: block;
    }

    .lux-input,
    .lux-select {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--glass-border);
        color: var(--scent-white);
        font-family: 'Montserrat', sans-serif;
        font-size: 0.95rem;
        padding: 0.8rem 1rem;
        width: 100%;
        border-radius: 2px;
        transition: all 0.3s;
    }

    .lux-input:focus,
    .lux-select:focus {
        background: rgba(255, 255, 255, 0.05);
        border-color: var(--gold);
        outline: none;
        box-shadow: none;
    }

    .lux-select option {
        background: var(--scent-black, #080808);
        color: var(--scent-white);
    }

    .lux-btn-primary {
        background: var(--gold);
        color: var(--scent-black, #080808);
        border: none;
        padding: 0.8rem 1.5rem;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        font-weight: 500;
        transition: all 0.3s;
        border-radius: 2px;
    }

    .lux-btn-primary:hover {
        background: var(--gold-light);
        opacity: 0.9;
    }

    .lux-btn-secondary {
        background: transparent;
        color: rgba(248, 244, 238, 0.6);
        border: 1px solid rgba(248, 244, 238, 0.2);
        padding: 0.8rem 1.5rem;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: all 0.3s;
        text-decoration: none;
        border-radius: 2px;
    }

    .lux-btn-secondary:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--scent-white);
        border-color: rgba(248, 244, 238, 0.5);
    }
</style>

<div class="lux-form-container">
    <h2 class="lux-form-title">Crear Reseña</h2>

    <form asp-action="Create" method="post">

        <div class="mb-4">
            <label asp-for="ProductoID" class="lux-label">Producto</label>
            <select asp-for="ProductoID" class="lux-select" asp-items="ViewBag.Productos"></select>
            <span asp-validation-for="ProductoID" class="text-danger small mt-2 d-block"
                style="color:#d9534f !important;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Calificacion" class="lux-label">Calificación (1 a 5)</label>
            <input asp-for="Calificacion" type="number" class="lux-input" min="1" max="5" />
            <span asp-validation-for="Calificacion" class="text-danger small mt-2 d-block"
                style="color:#d9534f !important;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Comentario" class="lux-label">Comentario</label>
            <textarea asp-for="Comentario" class="lux-input" rows="3"></textarea>
            <span asp-validation-for="Comentario" class="text-danger small mt-2 d-block"
                style="color:#d9534f !important;"></span>
        </div>

        <div class="d-flex justify-content-between mt-5 pt-2" style="border-top: 1px solid rgba(255,255,255,0.05);">
            <a asp-action="Index" class="lux-btn-secondary">Cancelar</a>
            <button type="submit" class="lux-btn-primary">Publicar Reseña</button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
