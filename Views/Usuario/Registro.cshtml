@model Scentify.Models.Usuario

@{
    Layout = null;
    ViewBag.Title = "Crear Cuenta";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title — Scentify</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Montserrat:wght@200;300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8D5A3;
            --black: #080808;
            --white: #F8F4EE;
            --glass-border: rgba(201,168,76,0.22);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100%;
            font-family: 'Montserrat', sans-serif;
            font-weight: 300;
            background: var(--black);
            color: var(--white);
        }

            /* ── noise overlay ── */
            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
                pointer-events: none;
                z-index: 0;
                opacity: 0.28;
            }

        /* ── BG PARTICLES ── */
        #reg-particles {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1;
            opacity: 0.38;
        }

        /* ── PAGE WRAPPER ── */
        #reg-page {
            position: relative;
            z-index: 2;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            padding: 4rem 2rem 5rem;
        }

        /* ── HEADER ── */
        .reg-header {
            text-align: center;
            margin-bottom: 3.5rem;
            animation: regFadeUp 0.9s ease both;
        }

        .reg-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            letter-spacing: 0.45em;
            color: var(--gold);
            display: block;
            text-decoration: none;
        }

            .reg-brand:hover {
                color: var(--gold-light);
            }

        .reg-tagline {
            font-size: 0.52rem;
            letter-spacing: 0.55em;
            color: rgba(201,168,76,0.42);
            text-transform: uppercase;
            margin-top: 0.3rem;
        }

        .reg-divider {
            width: 50px;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
            margin: 1.4rem auto 0;
        }

        /* ── CARD ── */
        .reg-card {
            width: 100%;
            max-width: 820px;
            background: rgba(10,10,10,0.96);
            border: 1px solid var(--glass-border);
            position: relative;
            padding: 3.5rem 3rem;
            animation: regFadeUp 0.9s ease 0.15s both;
        }

            .reg-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: linear-gradient(to right, transparent, var(--gold), transparent);
            }

        .reg-eyebrow {
            font-size: 0.5rem;
            letter-spacing: 0.55em;
            color: var(--gold);
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1rem;
        }

            .reg-eyebrow::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--glass-border);
            }

        .reg-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.5rem;
            font-weight: 300;
            color: var(--white);
            margin-bottom: 0.3rem;
        }

            .reg-title em {
                font-style: italic;
                color: var(--gold);
            }

        .reg-subtitle {
            font-size: 0.6rem;
            color: rgba(248,244,238,0.28);
            letter-spacing: 0.1em;
            margin-bottom: 2.8rem;
        }

        /* ── SECTION DIVIDERS ── */
        .reg-section {
            margin-bottom: 2rem;
        }

        .reg-section-title {
            font-size: 0.5rem;
            letter-spacing: 0.5em;
            color: rgba(201,168,76,0.55);
            text-transform: uppercase;
            margin-bottom: 1.4rem;
            padding-bottom: 0.7rem;
            border-bottom: 1px solid var(--glass-border);
        }

        /* ── FIELDS ── */
        .reg-label {
            display: block;
            font-size: 0.5rem;
            letter-spacing: 0.4em;
            color: rgba(201,168,76,0.65);
            text-transform: uppercase;
            margin-bottom: 0.5rem;
        }

        .reg-input,
        .reg-select {
            width: 100%;
            background: rgba(255,255,255,0.025);
            border: 1px solid var(--glass-border);
            color: var(--white);
            padding: 0.85rem 1rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.68rem;
            font-weight: 300;
            letter-spacing: 0.04em;
            outline: none;
            transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
            -webkit-appearance: none;
            appearance: none;
            border-radius: 0;
        }

            .reg-input:focus,
            .reg-select:focus {
                border-color: var(--gold);
                background: rgba(201,168,76,0.04);
                box-shadow: 0 0 0 1px rgba(201,168,76,0.12);
            }

            .reg-input::placeholder {
                color: rgba(248,244,238,0.15);
            }

            .reg-input:-webkit-autofill {
                -webkit-box-shadow: 0 0 0 100px #0e0e0e inset !important;
                -webkit-text-fill-color: var(--white) !important;
            }

        /* select arrow */
        .reg-select-wrap {
            position: relative;
        }

            .reg-select-wrap::after {
                content: '›';
                position: absolute;
                right: 1rem;
                top: 50%;
                transform: translateY(-50%) rotate(90deg);
                color: rgba(201,168,76,0.5);
                pointer-events: none;
                font-size: 1rem;
            }

        .reg-select option {
            background: #111;
            color: var(--white);
        }

        /* validation */
        .text-danger,
        .field-validation-error {
            display: block;
            font-size: 0.52rem;
            color: rgba(220,80,80,0.85);
            letter-spacing: 0.05em;
            margin-top: 0.3rem;
        }

        .reg-alert {
            background: rgba(220,53,69,0.07);
            border: 1px solid rgba(220,53,69,0.22);
            padding: 0.8rem 1rem;
            margin-bottom: 1.5rem;
            font-size: 0.58rem;
            color: rgba(220,80,80,0.85);
            letter-spacing: 0.05em;
        }

        /* ── PASSWORD INPUT ── */
        .reg-pwd-wrap {
            position: relative;
        }

            .reg-pwd-wrap .reg-input {
                padding-right: 2.8rem;
            }

        .reg-pwd-toggle {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            color: rgba(201,168,76,0.35);
            cursor: pointer;
            font-size: 0.8rem;
            transition: color 0.3s;
        }

            .reg-pwd-toggle:hover {
                color: var(--gold);
            }

        /* ── SUBMIT ── */
        .reg-btn {
            width: 100%;
            background: var(--gold);
            border: none;
            color: var(--black);
            padding: 1rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.58rem;
            letter-spacing: 0.45em;
            text-transform: uppercase;
            font-weight: 600;
            cursor: pointer;
            margin-top: 1rem;
            position: relative;
            overflow: hidden;
            transition: background 0.3s;
        }

            .reg-btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.17), transparent);
                transition: left 0.45s ease;
            }

            .reg-btn:hover {
                background: var(--gold-light);
            }

                .reg-btn:hover::before {
                    left: 100%;
                }

            .reg-btn:disabled {
                opacity: 0.55;
                cursor: not-allowed;
            }

            .reg-btn .t-normal {
                display: inline;
            }

            .reg-btn .t-loading {
                display: none;
            }

            .reg-btn.is-loading .t-normal {
                display: none;
            }

            .reg-btn.is-loading .t-loading {
                display: inline;
            }

        /* ── FOOTER ── */
        .reg-footer-link {
            text-align: center;
            margin-top: 2rem;
            font-size: 0.55rem;
            color: rgba(248,244,238,0.28);
            letter-spacing: 0.12em;
        }

            .reg-footer-link a {
                color: rgba(201,168,76,0.55);
                text-decoration: none;
                transition: color 0.3s;
            }

                .reg-footer-link a:hover {
                    color: var(--gold);
                }

        /* ── ANIMATIONS ── */
        @@keyframes regFadeUp {
            from

        {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        @@media (max-width: 600px) {
            .reg-card

        {
            padding: 2.5rem 1.5rem;
        }

        }
    </style>
</head>
<body>

    <canvas id="reg-particles"></canvas>

    <div id="reg-page">

        <!-- ── HEADER ── -->
        <div class="reg-header">
            <a asp-controller="Login" asp-action="Index" class="reg-brand">Scentify</a>
            <div class="reg-tagline">Haute Parfumerie</div>
            <div class="reg-divider"></div>
        </div>

        <!-- ── CARD ── -->
        <div class="reg-card">

            <div class="reg-eyebrow">Nueva cuenta</div>
            <h1 class="reg-title">Crear <em>cuenta</em></h1>
            <p class="reg-subtitle">Completa tus datos para unirte a Scentify</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="reg-alert">Revisa los campos antes de continuar.</div>
            }

            <form asp-action="Create" asp-controller="Registro" method="post" id="regForm" class="row g-4">
                @Html.AntiForgeryToken()

                <!-- ── SECCIÓN: Datos personales ── -->
                <div class="col-12">
                    <div class="reg-section-title">Datos personales</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Identificacion" class="reg-label">Identificación</label>
                    <input asp-for="Identificacion" class="reg-input" placeholder="Número de identificación" />
                    <span asp-validation-for="Identificacion" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="DocumentoIdentidad" class="reg-label">Tipo de documento</label>
                    <div class="reg-select-wrap">
                        <select asp-for="DocumentoIdentidad" class="reg-select">
                            <option value="">Seleccione un tipo</option>
                            <option value="Cédula Nacional Costarricense">Cédula Nacional Costarricense</option>
                            <option value="Pasaporte">Pasaporte</option>
                            <option value="DIMEX">DIMEX</option>
                            <option value="Otro">Otro</option>
                        </select>
                    </div>
                    <span asp-validation-for="DocumentoIdentidad" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Nombre" class="reg-label">Nombre</label>
                    <input asp-for="Nombre" class="reg-input" placeholder="Tu nombre" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Apellido1" class="reg-label">Primer apellido</label>
                    <input asp-for="Apellido1" class="reg-input" placeholder="Primer apellido" />
                    <span asp-validation-for="Apellido1" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Apellido2" class="reg-label">Segundo apellido</label>
                    <input asp-for="Apellido2" class="reg-input" placeholder="Segundo apellido" />
                    <span asp-validation-for="Apellido2" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FechaNacimiento" class="reg-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="reg-input" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Rol" class="reg-label">Rol</label>
                    <div class="reg-select-wrap">
                        <select asp-for="Rol" class="reg-select">
                            <option value="Cliente">Cliente</option>
                        </select>
                    </div>
                    <span asp-validation-for="Rol" class="text-danger"></span>
                </div>

                <!-- ── SECCIÓN: Acceso ── -->
                <div class="col-12 mt-2">
                    <div class="reg-section-title">Datos de acceso</div>
                </div>

                <div class="col-md-12">
                    <label asp-for="Email" class="reg-label">Correo electrónico</label>
                    <input asp-for="Email" type="email" class="reg-input" placeholder="tu@correo.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-12">
                    <label asp-for="Contrasena" class="reg-label">Contraseña</label>
                    <div class="reg-pwd-wrap">
                        <input asp-for="Contrasena" type="password" id="regPwd" class="reg-input" placeholder="••••••••" autocomplete="new-password" />
                        <button type="button" class="reg-pwd-toggle" id="toggleRegPwd" tabindex="-1">
                            <i class="fas fa-eye" id="regEyeIco"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <!-- ── SUBMIT ── -->
                <div class="col-12 mt-2">
                    <button type="submit" class="reg-btn" id="regSubmitBtn">
                        <span class="t-normal"><i class="fas fa-user-plus me-2"></i>Crear mi cuenta</span>
                        <span class="t-loading"><i class="fas fa-circle-notch fa-spin me-2"></i>Registrando…</span>
                    </button>
                </div>

                <div class="col-12">
                    <div class="reg-footer-link">
                        ¿Ya tienes cuenta?
                        <a asp-action="Login" asp-controller="Usuario">Iniciar sesión</a>
                    </div>
                </div>

            </form>
        </div><!-- /.reg-card -->

    </div><!-- /#reg-page -->
    <!-- ══════════════ SCRIPTS ══════════════ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <script>
        /* ── Toggle password ── */
        document.getElementById('toggleRegPwd')?.addEventListener('click', function () {
            const inp = document.getElementById('regPwd');
            const ico = document.getElementById('regEyeIco');
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            ico.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        });

        /* ── Loading state ── */
        document.getElementById('regForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('regSubmitBtn');
            btn.classList.add('is-loading');
            btn.disabled = true;
        });

        /* ── 2D background particles ── */
        (function () {
            const c = document.getElementById('reg-particles');
            if (!c) return;
            const ctx = c.getContext('2d');
            function resize() { c.width = window.innerWidth; c.height = window.innerHeight; }
            resize();
            window.addEventListener('resize', resize);

            const pts = Array.from({ length: 60 }, () => ({
                x: Math.random() * c.width,
                y: Math.random() * c.height,
                r: Math.random() * 1.3 + 0.3,
                vx: (Math.random() - .5) * .25,
                vy: -(Math.random() * .3 + .07),
                a: Math.random() * .32 + .07
            }));

            (function draw() {
                ctx.clearRect(0, 0, c.width, c.height);
                pts.forEach(p => {
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = `rgba(201,168,76,${p.a})`;
                    ctx.fill();
                    p.x += p.vx; p.y += p.vy;
                    if (p.y < -5) { p.y = c.height + 5; p.x = Math.random() * c.width; }
                    if (p.x < 0 || p.x > c.width) p.vx *= -1;
                });
                requestAnimationFrame(draw);
            })();
        })();
    </script>

</body>
</html>
