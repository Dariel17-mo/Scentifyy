@model Scentify.Models.Login

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar Sesión — Scentify</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Montserrat:wght@200;300;400;500&display=swap"
        rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8D5A3;
            --gold-dim: rgba(201, 168, 76, 0.18);
            --black: #080808;
            --white: #F8F4EE;
            --glass-border: rgba(201, 168, 76, 0.22);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html,
        body {
            height: 100%;
            font-family: 'Montserrat', sans-serif;
            font-weight: 300;
            background: var(--black);
            color: var(--white);
            overflow: hidden;
        }

        /* ─── LAYOUT ─── */
        #login-page {
            display: grid;
            grid-template-columns: 1fr 1fr;
            height: 100vh;
            overflow: hidden;
        }

        /* ─── LEFT PANEL ─── */
        .lp-left {
            position: relative;
            overflow: hidden;
            background: var(--black);
        }

        #lp-canvas {
            position: absolute;
            inset: 0;
            width: 100% !important;
            height: 100% !important;
        }

        /* noise */
        .lp-left::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 2;
            opacity: 0.3;
        }

        .lp-left-content {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 10;
            pointer-events: none;
            text-align: center;
            padding: 3rem;
        }

        .lp-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 4.5rem;
            font-weight: 300;
            letter-spacing: 0.5em;
            color: var(--gold);
            line-height: 1;
            animation: lpFadeUp 1s ease 0.2s both;
        }

        .lp-sub {
            font-size: 0.8rem;
            letter-spacing: 0.5em;
            color: var(--gold-light);
            text-transform: uppercase;
            margin-top: 0.8rem;
            animation: lpFadeUp 1s ease 0.4s both;
            font-weight: 500;
        }

        .lp-line {
            width: 50px;
            height: 1px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
            margin: 2rem auto;
            animation: lpFadeUp 1s ease 0.6s both;
        }

        .lp-quote {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.15rem;
            font-weight: 400;
            font-style: italic;
            color: var(--white);
            line-height: 1.8;
            max-width: 320px;
            animation: lpFadeUp 1s ease 0.8s both;
            opacity: 0.8;
        }

        /* ─── RIGHT PANEL ─── */
        .lp-right {
            background: rgba(9, 9, 9, 0.99);
            border-left: 1px solid var(--glass-border);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 4.5rem;
            position: relative;
            overflow-y: auto;
        }

        /* top gold bar */
        .lp-right::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(to right, transparent, var(--gold), transparent);
        }

        .lp-form-box {
            width: 100%;
            max-width: 360px;
            animation: lpFadeUp 0.9s ease 0.15s both;
        }

        .lp-eyebrow {
            font-size: 0.52rem;
            letter-spacing: 0.55em;
            color: var(--gold);
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.2rem;
        }

        .lp-eyebrow::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--glass-border);
        }

        .lp-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.9rem;
            font-weight: 300;
            line-height: 1.05;
            color: var(--white);
            margin-bottom: 0.4rem;
        }

        .lp-title em {
            font-style: italic;
            color: var(--gold);
        }

        .lp-desc {
            font-size: 0.8rem;
            color: var(--white);
            letter-spacing: 0.05em;
            margin-bottom: 2.8rem;
            font-weight: 400;
            opacity: 0.85;
        }

        /* ─── FIELDS ─── */
        .lp-field {
            margin-bottom: 1.3rem;
        }

        .lp-label {
            display: block;
            font-size: 0.75rem;
            letter-spacing: 0.25em;
            color: var(--gold-light);
            text-transform: uppercase;
            margin-bottom: 0.65rem;
            font-weight: 500;
        }

        .lp-input-wrap {
            position: relative;
        }

        .lp-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--gold);
            color: var(--white);
            padding: 1rem 2.8rem 1rem 1.2rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            font-weight: 400;
            letter-spacing: 0.04em;
            outline: none;
            transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
            -webkit-appearance: none;
            border-radius: 4px;
        }

        .lp-input:focus {
            border-color: var(--gold);
            background: rgba(201, 168, 76, 0.04);
            box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.12);
        }

        .lp-input::placeholder {
            color: rgba(248, 244, 238, 0.5);
        }

        .lp-input:-webkit-autofill {
            -webkit-box-shadow: 0 0 0 100px #0e0e0e inset !important;
            -webkit-text-fill-color: var(--white) !important;
        }

        .lp-input-icon {
            position: absolute;
            right: 1.2rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--gold-light);
            font-size: 1rem;
            background: none;
            border: none;
            padding: 0;
            cursor: pointer;
            transition: color 0.3s;
        }

        .lp-input-icon:hover {
            color: var(--gold);
        }

        /* validation */
        .field-validation-error,
        .text-danger {
            display: block;
            font-size: 0.52rem;
            color: rgba(220, 80, 80, 0.85);
            letter-spacing: 0.05em;
            margin-top: 0.35rem;
        }

        .lp-error-box {
            background: rgba(220, 53, 69, 0.07);
            border: 1px solid rgba(220, 53, 69, 0.22);
            padding: 0.8rem 1rem;
            margin-bottom: 1.4rem;
            font-size: 0.58rem;
            color: rgba(220, 80, 80, 0.85);
            letter-spacing: 0.05em;
            line-height: 1.8;
        }

        .lp-error-box ul {
            margin: 0;
            padding-left: 1.1rem;
        }

        .lp-btn {
            width: 100%;
            background: var(--gold);
            border: none;
            color: var(--black);
            padding: 1.1rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            font-weight: 600;
            cursor: pointer;
            margin-top: 0.8rem;
            position: relative;
            overflow: hidden;
            transition: background 0.3s, transform 0.2s;
            border-radius: 4px;
        }

        .lp-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.18), transparent);
            transition: left 0.45s ease;
        }

        .lp-btn:hover {
            background: var(--gold-light);
        }

        .lp-btn:hover::before {
            left: 100%;
        }

        .lp-btn:active {
            transform: scale(0.995);
        }

        .lp-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        .lp-btn .t-normal {
            display: inline;
        }

        .lp-btn .t-loading {
            display: none;
        }

        .lp-btn.is-loading .t-normal {
            display: none;
        }

        .lp-btn.is-loading .t-loading {
            display: inline;
        }

        .lp-links {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 0.6rem;
        }

        .lp-links a {
            font-size: 0.72rem;
            letter-spacing: 0.05em;
            color: rgba(232, 213, 163, 0.8);
            text-decoration: none;
            transition: color 0.3s;
            font-weight: 400;
        }

        .lp-links a:hover {
            color: var(--white);
            text-decoration: underline;
        }

        /* ─── ANIMATIONS ─── */
        @@keyframes lpFadeUp {
            from {
                opacity: 0;
                transform: translateY(22px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }

        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 820px) {
            #login-page {
                grid-template-columns: 1fr;
            }

            .lp-left {
                display: none;
            }

            .lp-right {
                padding: 5rem 2rem 3rem;
                border-left: none;
            }

            html,
            body {
                overflow-y: auto;
            }

        }
    </style>
</head>

<body>

    <div id="login-page">

        <!-- ══════════════ LEFT: 3D SCENE ══════════════ -->
        <div class="lp-left">
            <canvas id="lp-canvas"></canvas>
            <div class="lp-left-content">
                <div class="lp-brand">Scentify</div>
                <div class="lp-sub">Privilege & Luxury</div>
                <div class="lp-line"></div>
                <p class="lp-quote">"Descubre tu verdadero yo a través del elixir de los dioses. La exclusividad tiene
                    aroma."</p>
            </div>
        </div>

        <!-- ══════════════ RIGHT: FORM ══════════════ -->
        <div class="lp-right">
            <div class="lp-form-box">

                <div class="lp-eyebrow">Bienvenido</div>
                <h1 class="lp-title">Iniciar <em>sesión</em></h1>
                <p class="lp-desc">Accede a tu cuenta para continuar</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                {
                        <div asp-validation-summary="All" class="lp-error-box"></div>
                }

                <form asp-controller="Usuario" asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <!-- Email -->
                    <div class="lp-field">
                        <label asp-for="Email" class="lp-label">Correo electrónico</label>
                        <div class="lp-input-wrap">
                            <input asp-for="Email" class="lp-input" type="email" autocomplete="email"
                                placeholder="tu@correo.com" value="Admin123@gmail.com" required />
                            <span class="lp-input-icon"><i class="fas fa-envelope"></i></span>
                        </div>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="lp-field">
                        <label asp-for="Contrasena" class="lp-label">Contraseña</label>
                        <div class="lp-input-wrap">
                            <input asp-for="Contrasena" class="lp-input" type="password" id="pwdInput"
                                autocomplete="current-password" placeholder="••••••••" value="Admin123" required />
                            <button type="button" class="lp-input-icon" id="togglePwd" tabindex="-1">
                                <i class="fas fa-eye" id="eyeIco"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Contrasena" class="text-danger"></span>
                    </div>

                    <button type="submit" class="lp-btn" id="submitBtn">
                        <span class="t-normal">Acceder</span>
                        <span class="t-loading">
                            <i class="fas fa-circle-notch fa-spin me-1"></i> Verificando…
                        </span>
                    </button>
                </form>

                <div class="lp-links">
                    <a asp-action="Registro" asp-controller="Usuario">¿Nuevo aquí? Crear una cuenta</a>
                    <a href="@Url.Action("RecuperarPassword", "Login")">¿Olvidaste tu contraseña?</a>
                </div>

            </div>
        </div>
    </div>

    <!-- ══════════════ SCRIPTS ══════════════ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script
        src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

    <script>
        /* ── Toggle password ── */
        document.getElementById('togglePwd')?.addEventListener('click', function () {
            const inp = document.getElementById('pwdInput');
            const ico = document.getElementById('eyeIco');
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            ico.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
        });

        /* ── Loading state on submit ── */
        document.getElementById('loginForm')?.addEventListener('submit', function () {
            const btn = document.getElementById('submitBtn');
            btn.classList.add('is-loading');
            btn.disabled = true;
        });

        /* ══════════════════════════════════════
           THREE.JS — LEFT PANEL SCENE
        ══════════════════════════════════════ */
        (function () {
            const canvas = document.getElementById('lp-canvas');
            if (!canvas) return;

            const W = canvas.parentElement.offsetWidth;
            const H = canvas.parentElement.offsetHeight;

            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setSize(W, H);
            renderer.setClearColor(0x000000, 0);

            const scene = new THREE.Scene();
            const camera = new THREE.PerspectiveCamera(52, W / H, 0.1, 100);
            camera.position.set(0, 0.2, 5.8);

            /* ── Helpers ── */
            function addRing(r, tube, col, op, rx, ry) {
                const m = new THREE.Mesh(
                    new THREE.TorusGeometry(r, tube, 16, 120),
                    new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: op })
                );
                m.rotation.x = rx; m.rotation.y = ry;
                scene.add(m); return m;
            }

            /* ── Rings ── */
            const r1 = addRing(3.0, 0.006, 0xC9A84C, 0.20, 1.15, 0.0);
            const r2 = addRing(4.3, 0.003, 0xC9A84C, 0.09, 0.40, 0.4);
            const r3 = addRing(1.9, 0.007, 0xC9A84C, 0.16, -0.75, 0.6);

            /* ── Orb ── */
            const orbM = new THREE.MeshPhongMaterial({
                color: 0x0c0c0c, emissive: 0xC9A84C,
                emissiveIntensity: 0.07, transparent: true, opacity: 0.28, shininess: 200
            });
            const orb = new THREE.Mesh(new THREE.SphereGeometry(0.9, 64, 64), orbM);
            scene.add(orb);

            /* ── Perfume bottle ── */
            const G = new THREE.Group();

            const bMat = new THREE.MeshPhongMaterial({ color: 0x0f0f0f, transparent: true, opacity: 0.52, shininess: 320 });
            const gMat = new THREE.MeshPhongMaterial({ color: 0xC9A84C, shininess: 600 });
            const lMat = new THREE.MeshPhongMaterial({ color: 0xD4A017, transparent: true, opacity: 0.78, shininess: 80 });
            const dkMat = new THREE.MeshPhongMaterial({ color: 0x1a1a1a, shininess: 90 });

            // base
            G.add(Object.assign(new THREE.Mesh(new THREE.CylinderGeometry(0.66, 0.72, 0.07, 32), dkMat), { position: new THREE.Vector3(0, 0, 0) }));
            // body
            const body = new THREE.Mesh(new THREE.CylinderGeometry(0.57, 0.64, 2.15, 32), bMat);
            body.position.y = 1.12; G.add(body);
            // liquid
            const liq = new THREE.Mesh(new THREE.CylinderGeometry(0.49, 0.56, 1.55, 32), lMat);
            liq.position.y = 0.9; G.add(liq);
            // neck
            const neck = new THREE.Mesh(new THREE.CylinderGeometry(0.20, 0.52, 0.44, 32), bMat);
            neck.position.y = 2.38; G.add(neck);
            // cap cylinder
            const cap = new THREE.Mesh(new THREE.CylinderGeometry(0.23, 0.20, 0.52, 32), gMat);
            cap.position.y = 2.88; G.add(cap);
            // cap sphere
            const capT = new THREE.Mesh(new THREE.SphereGeometry(0.23, 32, 32), gMat);
            capT.scale.y = 0.48; capT.position.y = 3.16; G.add(capT);
            // gold bands
            [0.44, 1.73].forEach(y => {
                const b = new THREE.Mesh(new THREE.CylinderGeometry(0.60, 0.60, 0.055, 32), gMat);
                b.position.y = y; G.add(b);
            });
            // glow
            G.add(new THREE.Mesh(
                new THREE.SphereGeometry(1.15, 32, 32),
                new THREE.MeshBasicMaterial({ color: 0xC9A84C, transparent: true, opacity: 0.045 })
            ));

            G.position.y = -1.35;
            scene.add(G);

            /* ── Particles ── */
            const pPos = new Float32Array(160 * 3);
            for (let i = 0; i < 160; i++) {
                pPos[i * 3] = (Math.random() - .5) * 17;
                pPos[i * 3 + 1] = (Math.random() - .5) * 17;
                pPos[i * 3 + 2] = (Math.random() - .5) * 9;
            }
            const pGeo = new THREE.BufferGeometry();
            pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
            scene.add(new THREE.Points(pGeo,
                new THREE.PointsMaterial({ color: 0xC9A84C, size: 0.022, transparent: true, opacity: 0.38 })
            ));

            /* ── Lights ── */
            scene.add(new THREE.AmbientLight(0xffffff, 0.22));
            const kl = new THREE.PointLight(0xffffff, 2.1, 22); kl.position.set(3, 5, 4); scene.add(kl);
            const rl = new THREE.PointLight(0xC9A84C, 1.9, 11); rl.position.set(-2, 2, -2); scene.add(rl);
            const fl = new THREE.PointLight(0xffffff, 0.4, 10); fl.position.set(0, -3, 3); scene.add(fl);

            /* ── Animation loop ── */
            let t = 0;
            (function tick() {
                requestAnimationFrame(tick);
                t += 0.007;

                r1.rotation.y += 0.0022;
                r2.rotation.y -= 0.0016;
                r3.rotation.z += 0.0012;

                orb.rotation.y += 0.003;
                orb.position.y = Math.sin(t * 1.1) * 0.1;
                orbM.emissiveIntensity = 0.04 + Math.sin(t * 2.2) * 0.025;

                G.rotation.y += 0.006;
                G.position.y = -1.35 + Math.sin(t * 0.85) * 0.11;

                rl.intensity = 1.6 + Math.sin(t) * 0.55;

                renderer.render(scene, camera);
            })();

            /* ── Resize ── */
            window.addEventListener('resize', () => {
                const nW = canvas.parentElement.offsetWidth;
                const nH = canvas.parentElement.offsetHeight;
                camera.aspect = nW / nH;
                camera.updateProjectionMatrix();
                renderer.setSize(nW, nH);
            });
        })();
    </script>

</body>

</html>

