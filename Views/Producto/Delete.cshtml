@model Scentify.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2>@ViewData["Title"]</h2>

<h3>¿Está seguro que desea eliminar este producto?</h3>

<div>
    <h4>Producto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">@Model.Precio.ToString("C")</dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@Model.Stock</dd>

        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Model.CategoriaNombre</dd>

        <dt class="col-sm-2">Marca</dt>
        <dd class="col-sm-10">@Model.MarcaNombre</dd>

        <dt class="col-sm-2">Género</dt>
        <dd class="col-sm-10">@Model.Genero</dd>

        <dt class="col-sm-2">Tamaño (ml)</dt>
        <dd class="col-sm-10">@Model.TamanioML</dd>

        <dt class="col-sm-2">Descuento</dt>
        <dd class="col-sm-10">@Model.Descuento.ToString("C")</dd>


        <dt class="col-sm-2">Imagen</dt>
        <dd class="col-sm-10">
            <img src="@Model.ImagenURL" alt="@Model.Nombre" style="max-width: 200px;" />
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="ProductoID" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>
