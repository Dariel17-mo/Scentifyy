@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Recuperar Contraseña — Scentify</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Montserrat:wght@200;300;400;500&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8D5A3;
            --black: #080808;
            --white: #F8F4EE;
            --glass-border: rgba(201, 168, 76, 0.22);
        }

        body {
            font-family: 'Montserrat', sans-serif;
            font-weight: 300;
            background: var(--black);
            color: var(--white);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        body::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 1;
            opacity: 0.3;
        }

        .recovery-box {
            background: rgba(14, 14, 14, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            padding: 4rem 3rem;
            width: 100%;
            max-width: 450px;
            text-align: center;
            z-index: 10;
            border-radius: 8px;
            animation: fadeInUp 0.8s ease;
        }

        .r-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2.2rem;
            letter-spacing: 0.4em;
            color: var(--gold);
            margin-bottom: 2rem;
        }

        .r-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 0.1em;
            margin-bottom: 1rem;
            font-weight: 400;
        }

        .r-desc {
            font-size: 0.8rem;
            color: rgba(248, 244, 238, 0.6);
            line-height: 1.6;
            margin-bottom: 2rem;
        }

        .r-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--gold);
            color: var(--white);
            padding: 1rem;
            font-family: 'Montserrat', sans-serif;
            font-size: 0.9rem;
            outline: none;
            transition: all 0.3s;
            margin-bottom: 1rem;
            text-align: center;
        }

        .r-input:focus {
            background: rgba(201, 168, 76, 0.05);
            box-shadow: 0 0 0 1px rgba(201, 168, 76, 0.2);
        }

        .r-btn {
            width: 100%;
            background: var(--gold);
            border: none;
            color: var(--black);
            padding: 1rem;
            font-weight: 600;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-size: 0.8rem;
            transition: background 0.3s;
        }

        .r-btn:hover {
            background: var(--gold-light);
        }

        .btn-back {
            display: inline-block;
            margin-top: 1.5rem;
            color: rgba(248,244,238,0.5);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-decoration: none;
            transition: color 0.3s;
        }

        .btn-back:hover {
            color: var(--gold);
        }

        .msg-error {
            color: #dc3545;
            font-size: 0.8rem;
            margin-bottom: 1rem;
            background: rgba(220,53,69,0.1);
            padding: 0.5rem;
            border: 1px solid rgba(220,53,69,0.3);
        }

        .msg-success {
            color: #198754;
            font-size: 0.8rem;
            margin-bottom: 1rem;
            background: rgba(25,135,84,0.1);
            padding: 0.5rem;
            border: 1px solid rgba(25,135,84,0.3);
        }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="recovery-box">
        <div class="r-brand">Scentify</div>
        <h1 class="r-title">RECUPERAR CONTRASEÑA</h1>
        <p class="r-desc">Ingresa el correo electrónico asociado a tu cuenta. Te enviaremos tu clave de acceso de inmediato.</p>

        @if (ViewBag.Error != null)
        {
            <div class="msg-error">@ViewBag.Error</div>
        }
        @if (ViewBag.Exito != null)
        {
            <div class="msg-success"><i class="fas fa-check-circle me-1"></i> @ViewBag.Exito</div>
        }

        <form method="post" asp-action="RecuperarPassword" asp-controller="Login">
            @Html.AntiForgeryToken()
            <input type="email" name="email" class="r-input" placeholder="tu@correo.com" required />
            
            <button type="submit" class="r-btn"><i class="fas fa-paper-plane me-2"></i> Enviar credenciales</button>
        </form>

        <a href="@Url.Action("Index", "Login")" class="btn-back"><i class="fas fa-arrow-left me-1"></i> Volver al Login</a>
    </div>

</body>
</html>
