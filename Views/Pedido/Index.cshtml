@model List<Scentify.Models.Pedido>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Pedidos";
    string perfil = HttpContextAccessor.HttpContext.Session.GetString("Perfil")?.ToUpper();

    string usuarioIdFiltro = Context.Request.Query["usuarioId"];
    string nombreFiltro = Context.Request.Query["nombre"];
    string fechaInicioFiltro = Context.Request.Query["fechaInicio"];
    string fechaFinFiltro = Context.Request.Query["fechaFin"];

    var pedidosPendientes = Model.Where(p => !string.Equals(p.Estado, "Pagado",
    StringComparison.OrdinalIgnoreCase)).ToList();
    var pedidosPagados = Model.Where(p => string.Equals(p.Estado, "Pagado", StringComparison.OrdinalIgnoreCase)).ToList();
}

<style>
    /* Estilos Lujo - Listado Pedidos */
    .orders-container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .orders-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2.6rem;
        font-weight: 300;
        color: var(--gold);
        text-align: center;
        margin-bottom: 2.5rem;
        letter-spacing: 0.1em;
    }

    .filter-box {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--glass-border);
        padding: 1.5rem;
        border-radius: 4px;
        margin-bottom: 2rem;
    }

    .filter-label {
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 0.5rem;
    }

    .filter-input {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--glass-border);
        color: var(--scent-white);
        font-size: 0.8rem;
    }

    .filter-input:focus {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--gold);
        color: var(--scent-white);
        outline: none;
        box-shadow: none;
    }

    .btn-gold-outline {
        background: transparent;
        border: 1px solid var(--gold);
        color: var(--gold);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: all 0.3s;
    }

    .btn-gold-outline:hover {
        background: rgba(201, 168, 76, 0.1);
        color: var(--gold-light);
    }

    .btn-clear {
        background: transparent;
        border: 1px solid rgba(248, 244, 238, 0.2);
        color: rgba(248, 244, 238, 0.6);
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        transition: all 0.3s;
    }

    .btn-clear:hover {
        background: rgba(255, 255, 255, 0.05);
        color: var(--scent-white);
        border-color: rgba(248, 244, 238, 0.5);
    }

    .section-subtitle {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.6rem;
        color: var(--scent-white);
        border-bottom: 1px solid var(--glass-border);
        padding-bottom: 0.5rem;
        margin-bottom: 1.5rem;
        margin-top: 3rem;
    }

    .orders-table th {
        background: transparent !important;
        color: var(--gold) !important;
        font-size: 0.7rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        border-bottom: 1px solid var(--glass-border) !important;
        font-weight: 500;
        padding-bottom: 1rem;
        border-top: none !important;
    }

    .orders-table td {
        background: transparent !important;
        color: var(--scent-white) !important;
        border-bottom: 1px solid rgba(201, 168, 76, 0.1) !important;
        vertical-align: middle;
        padding: 1.2rem 0.5rem;
        font-size: 0.9rem;
    }

    .status-badge {
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        padding: 0.4rem 0.8rem;
        text-transform: uppercase;
        border: 1px solid transparent;
        border-radius: 2px;
    }

    .status-pending {
        background: rgba(201, 168, 76, 0.1);
        color: var(--gold);
        border-color: rgba(201, 168, 76, 0.3);
    }

    .status-paid {
        background: rgba(25, 135, 84, 0.1);
        color: #75b798;
        border-color: rgba(25, 135, 84, 0.3);
    }

    .btn-detail {
        background: transparent;
        border: 1px solid var(--glass-border);
        color: var(--scent-white);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 0.4rem 0.8rem;
        transition: all 0.3s;
    }

    .btn-detail:hover {
        border-color: var(--gold);
        color: var(--gold);
        background: rgba(201, 168, 76, 0.05);
    }

    /* Modal de lujo */
    .modal-content.luxury-modal {
        background: rgba(10, 10, 10, 0.95);
        border: 1px solid var(--gold);
        backdrop-filter: blur(10px);
        color: var(--scent-white);
    }

    .luxury-modal .modal-header {
        border-bottom: 1px solid var(--glass-border);
        background: transparent;
    }

    .luxury-modal .modal-title {
        font-family: 'Cormorant Garamond', serif;
        color: var(--gold);
        font-size: 1.5rem;
        letter-spacing: 0.1em;
    }

    .btn-close-white {
        filter: invert(1) grayscale(100%) brightness(200%);
    }
</style>

<div class="orders-container">
    <h2 class="orders-title">Historial de Pedidos</h2>

    @if (perfil == "ADMINISTRADOR")
    {
        <div class="filter-box">
            <form asp-action="Index" asp-controller="Pedido" method="get" class="row g-3 align-items-end">
                <div class="col-md-2">
                    <label class="form-label filter-label">Usuario ID</label>
                    <input type="number" name="usuarioId" class="form-control filter-input" value="@usuarioIdFiltro" />
                </div>
                <div class="col-md-3">
                    <label class="form-label filter-label">Nombre</label>
                    <input type="text" name="nombre" class="form-control filter-input" value="@nombreFiltro" />
                </div>
                <div class="col-md-2">
                    <label class="form-label filter-label">Desde</label>
                    <input type="date" name="fechaInicio" class="form-control filter-input" value="@fechaInicioFiltro" />
                </div>
                <div class="col-md-2">
                    <label class="form-label filter-label">Hasta</label>
                    <input type="date" name="fechaFin" class="form-control filter-input" value="@fechaFinFiltro" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-gold-outline w-100">
                        <i class="fas fa-filter"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-clear w-100 text-center">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    }

    @if (!string.IsNullOrEmpty(usuarioIdFiltro) || !string.IsNullOrEmpty(nombreFiltro) ||
    !string.IsNullOrEmpty(fechaInicioFiltro) || !string.IsNullOrEmpty(fechaFinFiltro))
    {
        <div class="alert filter-box py-2 text-center" style="border-color:var(--gold);">
            <span style="font-size:0.7rem;letter-spacing:0.1em;color:var(--gold-light);text-transform:uppercase;">Filtros
                aplicados:</span>
            <div class="small mt-2 d-flex justify-content-center gap-4 flex-wrap" style="color:var(--scent-white);">
                @if (!string.IsNullOrEmpty(usuarioIdFiltro))
                {
                    <span><i class="fas fa-user" style="color:var(--gold);"></i> ID: @usuarioIdFiltro</span>
                }
                @if (!string.IsNullOrEmpty(nombreFiltro))
                {
                    <span><i class="fas fa-user-tag" style="color:var(--gold);"></i> Nombre: @nombreFiltro</span>
                }
                @if (!string.IsNullOrEmpty(fechaInicioFiltro))
                {
                    <span><i class="fas fa-calendar-alt" style="color:var(--gold);"></i> Desde: @fechaInicioFiltro</span>
                }
                @if (!string.IsNullOrEmpty(fechaFinFiltro))
                {
                    <span><i class="fas fa-calendar-day" style="color:var(--gold);"></i> Hasta: @fechaFinFiltro</span>
                }
            </div>
        </div>
    }

    <h5 class="section-subtitle">Pedidos Pendientes</h5>
    <div class="table-responsive mb-5">
        <table class="table align-middle orders-table text-center">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidosPendientes.Any())
                {
                    foreach (var pedido in pedidosPendientes)
                    {
                        <tr>
                            <td>@pedido.UsuarioNombre</td>
                            <td style="color:rgba(248,244,238,0.6);font-size:0.8rem;">@pedido.Email</td>
                            <td style="font-size:0.85rem;">@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="color:var(--gold);font-weight:500;">₡@pedido.Total.ToString("N2")</td>
                            <td><span class="status-badge status-pending">@pedido.Estado</span></td>
                            <td>
                                <button class="btn btn-detail ver-detalle" data-id="@pedido.PedidoID">
                                    <i class="fas fa-eye"></i> Detalles
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4" style="color:rgba(248,244,238,0.4);font-style:italic;">No
                            hay pedidos pendientes.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h5 class="section-subtitle">Pedidos Pagados / Completados</h5>
    <div class="table-responsive">
        <table class="table align-middle orders-table text-center">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (pedidosPagados.Any())
                {
                    foreach (var pedido in pedidosPagados)
                    {
                        <tr>
                            <td>@pedido.UsuarioNombre</td>
                            <td style="color:rgba(248,244,238,0.6);font-size:0.8rem;">@pedido.Email</td>
                            <td style="font-size:0.85rem;">@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td style="color:var(--gold);font-weight:500;">₡@pedido.Total.ToString("N2")</td>
                            <td><span class="status-badge status-paid"><i
                                        class="fas fa-check-circle pe-1"></i>@pedido.Estado</span></td>
                            <td>
                                <button class="btn btn-detail ver-detalle" data-id="@pedido.PedidoID">
                                    <i class="fas fa-eye"></i> Detalles
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4" style="color:rgba(248,244,238,0.4);font-style:italic;">No
                            hay pedidos pagados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Modal para mostrar detalles -->
    <div class="modal fade" id="detalleModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content luxury-modal">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle de la Colección</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4" id="detalleModalContent">
                    <div class="text-center py-5">
                        <i class="fas fa-circle-notch fa-spin fa-2x" style="color:var(--gold);"></i>
                        <p class="mt-3"
                            style="color:rgba(248,244,238,0.5);font-size:0.8rem;letter-spacing:0.1em;text-transform:uppercase;">
                            Preparando detalles...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $(".ver-detalle").click(function () {
                var pedidoId = $(this).data("id");
                $("#detalleModalContent").html("<p class='text-muted text-center'>Cargando detalles del pedido...</p>");
                $("#detalleModal").modal("show");

                $.get("/DetallePedido/DetallesPorPedido", { pedidoId: pedidoId }, function (data) {
                    $("#detalleModalContent").html(data);
                }).fail(function () {
                    $("#detalleModalContent").html("<p class='text-danger text-center'>Ocurrió un error al cargar los detalles.</p>");
                });
            });
        });
    </script>
}
