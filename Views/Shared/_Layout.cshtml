@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@inject Scentify.Data.CarritoCompraRepository CarritoRepo
@{
    var perfil = HttpContextAccessor.HttpContext.Session.GetString("Perfil");
    var usuario = HttpContextAccessor.HttpContext.Session.GetString("UsuarioNombre");
    var email = HttpContextAccessor.HttpContext.Session.GetString("UsuarioEmail");
    var usuarioId = HttpContextAccessor.HttpContext.Session.GetInt32("UsuarioID");
    
    int cartCount = 0;
    if (usuarioId != null)
    {
        var carrito = CarritoRepo.GetByUsuario(usuarioId.Value);
        cartCount = carrito.Sum(c => c.Cantidad);
    }
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Scentify</title>

    <!-- Bootstrap + FontAwesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />

    <!-- Tipografías de lujo -->
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Montserrat:wght@100;200;300;400;500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        :root {
            --gold: #C9A84C;
            --gold-light: #E8D5A3;
            --gold-dark: #8B6914;
            --scent-black: #080808;
            --scent-white: #F8F4EE;
            --glass: rgba(255,255,255,0.04);
            --glass-border: rgba(201,168,76,0.2);
        }

        /* ── CURSOR ── */
        *, *::before, *::after {
            box-sizing: border-box;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            font-weight: 300;
            background: var(--scent-black);
            color: var(--scent-white);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ── NAVBAR ── */
        .scentify-nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1.1rem 3rem;
            background: linear-gradient(to bottom, rgba(8,8,8,0.97) 0%, rgba(8,8,8,0.85) 100%);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            transition: padding 0.3s ease;
        }

            .scentify-nav.scrolled {
                padding: 0.7rem 3rem;
            }

        .nav-brand {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 300;
            letter-spacing: 0.35em;
            color: var(--gold) !important;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.7rem;
        }

            .nav-brand img {
                height: 32px;
                filter: brightness(0) invert(1) sepia(1) saturate(2) hue-rotate(5deg);
            }

        .nav-links-center {
            display: flex;
            gap: 2.5rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .nav-links-center a {
                color: rgba(248,244,238,0.55);
                text-decoration: none;
                font-size: 0.62rem;
                letter-spacing: 0.3em;
                text-transform: uppercase;
                transition: color 0.3s;
                font-weight: 400;
            }

                .nav-links-center a:hover {
                    color: var(--gold);
                }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .nav-icon-btn {
            background: transparent;
            border: none;
            color: rgba(248,244,238,0.55);
            font-size: 0.62rem;
            letter-spacing: 0.25em;
            text-transform: uppercase;
            cursor: pointer;
            transition: color 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.4rem;
            padding: 0;
        }

            .nav-icon-btn:hover {
                color: var(--gold);
            }

            .nav-icon-btn i {
                font-size: 1rem;
            }

        .cart-badge {
            background: var(--gold);
            color: var(--scent-black);
            font-size: 0.55rem;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            position: absolute;
            top: -6px;
            right: -8px;
        }

        /* Mobile toggler */
        .nav-toggler {
            display: none;
            background: transparent;
            border: 1px solid var(--glass-border);
            color: var(--gold);
            padding: 0.4rem 0.7rem;
            font-size: 1.1rem;
            cursor: pointer;
        }

        @@media (max-width: 900px) {
            .scentify-nav

        {
            padding: 1rem 1.5rem;
        }

        .nav-links-center {
            display: none;
        }

        .nav-toggler {
            display: block;
        }

        }

        /* ── MOBILE MENU ── */
        .mobile-menu {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(8,8,8,0.98);
            z-index: 1060;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2.5rem;
        }

            .mobile-menu.open {
                display: flex;
            }

            .mobile-menu a {
                font-family: 'Cormorant Garamond', serif;
                font-size: 2rem;
                font-weight: 300;
                color: var(--scent-white);
                text-decoration: none;
                letter-spacing: 0.2em;
                transition: color 0.3s;
            }

                .mobile-menu a:hover {
                    color: var(--gold);
                }

        .mobile-close {
            position: absolute;
            top: 1.5rem;
            right: 2rem;
            background: transparent;
            border: none;
            color: var(--gold);
            font-size: 1.5rem;
            cursor: pointer;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            padding-top: 70px; /* altura del navbar fijo */
        }

        /* ── OFFCANVAS PERFIL (rediseñado) ── */
        .offcanvas {
            background: rgba(10,10,10,0.98) !important;
            border-left: 1px solid var(--glass-border) !important;
            backdrop-filter: blur(30px);
        }

        .offcanvas-header {
            background: transparent !important;
            border-bottom: 1px solid var(--glass-border);
            padding: 1.5rem 2rem;
        }

        .offcanvas-title {
            font-family: 'Cormorant Garamond', serif !important;
            font-size: 1.4rem !important;
            font-weight: 300 !important;
            letter-spacing: 0.3em;
            color: var(--gold) !important;
        }

        .btn-close-white {
            filter: invert(1) sepia(1) saturate(2) hue-rotate(5deg) !important;
        }

        .offcanvas-body {
            padding: 2rem !important;
        }

        .perfil-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            border: 1px solid var(--glass-border);
            background: rgba(201,168,76,0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
            font-size: 2rem;
            color: var(--gold);
        }

        .perfil-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.3rem;
            font-weight: 300;
            color: var(--scent-white);
            margin-bottom: 0.2rem;
        }

        .perfil-email {
            font-size: 0.6rem;
            letter-spacing: 0.1em;
            color: rgba(248,244,238,0.35);
        }

        .perfil-badge {
            display: inline-block;
            margin-top: 0.6rem;
            border: 1px solid var(--glass-border);
            color: var(--gold);
            font-size: 0.55rem;
            letter-spacing: 0.3em;
            padding: 0.25rem 0.8rem;
            text-transform: uppercase;
            background: rgba(201,168,76,0.06);
        }

        .perfil-divider {
            border: none;
            border-top: 1px solid var(--glass-border);
            margin: 1.5rem 0;
        }

        .perfil-section-title {
            font-size: 0.52rem;
            letter-spacing: 0.5em;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 1.2rem;
        }

        .perfil-btn {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            width: 100%;
            padding: 0.8rem 1.2rem;
            background: transparent;
            border: 1px solid var(--glass-border);
            color: rgba(248,244,238,0.6);
            font-family: 'Montserrat', sans-serif;
            font-size: 0.6rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s;
            margin-bottom: 0.6rem;
        }

            .perfil-btn:hover {
                border-color: var(--gold);
                color: var(--gold);
                background: rgba(201,168,76,0.06);
            }

            .perfil-btn i {
                font-size: 0.9rem;
                color: var(--gold);
            }

        .perfil-btn-danger {
            border-color: rgba(220,53,69,0.3) !important;
            color: rgba(220,53,69,0.7) !important;
        }

            .perfil-btn-danger:hover {
                border-color: #dc3545 !important;
                color: #dc3545 !important;
                background: rgba(220,53,69,0.06) !important;
            }

            .perfil-btn-danger i {
                color: #dc3545 !important;
            }

        /* ── FOOTER ── */
        .scentify-footer {
            background: rgba(5,5,5,0.98);
            border-top: 1px solid var(--glass-border);
            padding: 4rem 3rem 2rem;
            margin-top: 6rem;
        }

        .footer-logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 300;
            letter-spacing: 0.35em;
            color: var(--gold);
            display: block;
            margin-bottom: 1rem;
        }

        .footer-desc {
            font-size: 0.65rem;
            line-height: 2;
            color: rgba(248,244,238,0.3);
            max-width: 260px;
            letter-spacing: 0.05em;
        }

        .footer-col-title {
            font-size: 0.52rem;
            letter-spacing: 0.5em;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 1.5rem;
        }

        .footer-col ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .footer-col li {
            margin-bottom: 0.8rem;
        }

        .footer-col a {
            font-size: 0.65rem;
            color: rgba(248,244,238,0.3);
            text-decoration: none;
            letter-spacing: 0.05em;
            transition: color 0.3s;
        }

            .footer-col a:hover {
                color: var(--gold);
            }

        .footer-divider {
            border: none;
            border-top: 1px solid var(--glass-border);
            margin: 2.5rem 0 1.5rem;
        }

        .footer-copy {
            font-size: 0.52rem;
            color: rgba(248,244,238,0.2);
            letter-spacing: 0.2em;
            text-align: center;
        }

        .footer-socials {
            display: flex;
            gap: 1.5rem;
        }

        .footer-social {
            font-size: 0.52rem;
            letter-spacing: 0.2em;
            color: rgba(201,168,76,0.4);
            text-decoration: none;
            transition: color 0.3s;
        }

            .footer-social:hover {
                color: var(--gold);
            }

        /* ── SCROLLBAR ── */
        ::-webkit-scrollbar {
            width: 4px;
        }

        ::-webkit-scrollbar-track {
            background: var(--scent-black);
        }

        ::-webkit-scrollbar-thumb {
            background: var(--gold-dark);
            border-radius: 2px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--gold);
            }
    </style>
</head>

<body>

    <!-- ═══════════════ NAVBAR ═══════════════ -->
    <nav class="scentify-nav" id="scentifyNav">
        <a class="nav-brand" href="@Url.Action("Index", "Home")">
            <img src="~/Images/Logo.png" alt="Scentify" />
            Scentify
        </a>

        <ul class="nav-links-center">
            @if ((perfil ?? "").ToUpper() == "ADMINISTRADOR")
            {
                <li><a asp-controller="Producto" asp-action="Index">Productos</a></li>
                <li><a asp-controller="Categoria" asp-action="Index">Categorías</a></li>
                <li><a asp-controller="Marca" asp-action="Index">Marcas</a></li>
                <li><a asp-controller="Resena" asp-action="Index">Reseñas</a></li>
                <li><a asp-controller="BitacoraTransacciones" asp-action="Index">Transacciones</a></li>
                <li><a asp-controller="Usuario" asp-action="Index">Usuarios</a></li>
                <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            }
            else if (!string.IsNullOrEmpty(usuario))
            {
                <li><a asp-controller="Producto" asp-action="Index">Productos</a></li>
                <li><a asp-controller="ClienteDashboard" asp-action="Index">Dashboard</a></li>
            }
        </ul>

        <div class="nav-right">
            @if (!string.IsNullOrEmpty(usuario))
            {
                <!-- Carrito -->
                <a class="nav-icon-btn position-relative" asp-controller="CarritoCompra" asp-action="Index" title="Carrito">
                    <i class="fas fa-shopping-bag"></i>
                    @if (cartCount > 0)
                    {
                        <span class="cart-badge">@cartCount</span>
                    }
                </a>
                <!-- Perfil -->
                <button class="nav-icon-btn" data-bs-toggle="offcanvas" data-bs-target="#perfilOffcanvas" title="Mi perfil">
                    <i class="fas fa-user-circle"></i>
                    <span>@usuario</span>
                </button>
            }
            else
            {
                <a class="nav-icon-btn" asp-controller="Login" asp-action="Index">
                    <i class="fas fa-sign-in-alt"></i>
                    <span>Acceder</span>
                </a>
            }
            <!-- Mobile -->
            <button class="nav-toggler" id="navToggler">&#9776;</button>
        </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
        <button class="mobile-close" id="mobileClose">&times;</button>
        @if ((perfil ?? "").ToUpper() == "ADMINISTRADOR")
        {
            <a asp-controller="Producto" asp-action="Index">Productos</a>
            <a asp-controller="Categoria" asp-action="Index">Categorías</a>
            <a asp-controller="Marca" asp-action="Index">Marcas</a>
            <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
        }
        else if (!string.IsNullOrEmpty(usuario))
        {
            <a asp-controller="Producto" asp-action="Index">Productos</a>
            <a asp-controller="ClienteDashboard" asp-action="Index">Dashboard</a>
            <a asp-controller="CarritoCompra" asp-action="Index">Carrito</a>
        }
        else
        {
            <a asp-controller="Login" asp-action="Index">Acceder</a>
        }
    </div>

    <!-- ═══════════════ CONTENIDO ═══════════════ -->
    <div class="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- ═══════════════ FOOTER ═══════════════ -->
    <footer class="scentify-footer">
        <div class="container-fluid px-2">
            <div class="row g-5">
                <div class="col-md-4">
                    <span class="footer-logo">Scentify</span>
                    <p class="footer-desc">Fragancias que despiertan emociones. Calidad, elegancia y estilo en cada esencia, seleccionadas para quienes aprecian lo extraordinario.</p>
                </div>
                <div class="col-md-2 footer-col">
                    <div class="footer-col-title">Catálogo</div>
                    <ul>
                        <li><a asp-controller="Producto" asp-action="Index">Todos los productos</a></li>
                        <li><a asp-controller="Categoria" asp-action="Index">Categorías</a></li>
                        <li><a asp-controller="Marca" asp-action="Index">Marcas</a></li>
                    </ul>
                </div>
                <div class="col-md-2 footer-col">
                    <div class="footer-col-title">Mi cuenta</div>
                    <ul>
                        <li><a asp-controller="CarritoCompra" asp-action="Index">Carrito</a></li>
                        <li><a asp-controller="Pedido" asp-action="Index">Mis pedidos</a></li>
                        @if (string.IsNullOrEmpty(usuario))
                        {
                            <li><a asp-controller="Login" asp-action="Index">Iniciar sesión</a></li>
                            <li><a asp-controller="Registro" asp-action="Index">Registrarse</a></li>
                        }
                    </ul>
                </div>
                <div class="col-md-2 footer-col">
                    <div class="footer-col-title">Legal</div>
                    <ul>
                        <li><a href="#">Privacidad</a></li>
                        <li><a href="#">Términos de uso</a></li>
                        <li><a href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <p class="footer-copy mb-0">&copy; 2025 Scentify. Todos los derechos reservados.</p>
                <div class="footer-socials">
                    <a href="#" class="footer-social">Instagram</a>
                    <a href="#" class="footer-social">Pinterest</a>
                    <a href="#" class="footer-social">Facebook</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ═══════════════ OFFCANVAS PERFIL ═══════════════ -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="perfilOffcanvas" aria-labelledby="perfilOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="perfilOffcanvasLabel">Mi Perfil</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body">
            <div class="text-center mb-4">
                <div class="perfil-avatar"><i class="fas fa-user"></i></div>
                <div class="perfil-name">@usuario</div>
                <div class="perfil-email">@email</div>
                <div class="perfil-badge">@perfil</div>
            </div>
            <hr class="perfil-divider" />
            <div class="perfil-section-title">Accesos rápidos</div>
            <div class="d-flex flex-column">
                <a asp-controller="CarritoCompra" asp-action="Index" class="perfil-btn">
                    <i class="fas fa-shopping-bag"></i> Ver Carrito
                </a>
                <a asp-controller="Pedido" asp-action="Index" class="perfil-btn">
                    <i class="fas fa-box"></i> Mis Pedidos
                </a>
                @if ((perfil ?? "").ToUpper() == "ADMINISTRADOR")
                {
                    <a asp-controller="TransaccionPago" asp-action="Index" class="perfil-btn">
                        <i class="fas fa-credit-card"></i> Ver Pagos
                    </a>
                }
                <form asp-controller="Usuario" asp-action="Logout" method="post" class="mt-2">
                    <button type="submit" class="perfil-btn perfil-btn-danger w-100">
                        <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ═══════════════ SCRIPTS ═══════════════ -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        // Navbar scroll
        window.addEventListener('scroll', () => {
            document.getElementById('scentifyNav').classList.toggle('scrolled', window.scrollY > 40);
        });
        // Mobile menu
        document.getElementById('navToggler')?.addEventListener('click', () => {
            document.getElementById('mobileMenu').classList.add('open');
        });
        document.getElementById('mobileClose')?.addEventListener('click', () => {
            document.getElementById('mobileMenu').classList.remove('open');
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
